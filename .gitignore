# 运行/构建产物不进仓库
dist/
build/
__pycache__/
*.pyc
.venv/
.pytest_cache/

# runtime：只把推理引擎 dafeiyu 入库（CI 打安装包要用它，约 63MB），
# 模型、下载缓存、日志、配置备份一律不进仓库
runtime/models/
runtime/_dl/
runtime/*.log
runtime/*.txt
runtime/backup_config_*.json

# 项目自带虚拟环境（本地自建，见 PROJECT.md 第一节）
venv/

# 大体积原始素材与过程截图（安装包与完整素材见 Release）
assets/_raw/
assets/_matting/

# 第三方打包工具二进制（本地自备，不进仓库）
tools/inno/
tools/innosetup-*.exe

# 本地测试残留
assets/_tts_test/
# 安全管家的假样本（含 powershell -enc / meterpreter 等字样，不进仓库，避免被误判成恶意代码）
tools/_guard_samples/

# 3D 便携工具链与本地构建产物（不进仓库）
.toolchains/
3d/*.exe
3d/*.dll
3d/*.obj
3d/*.zip
3d/*.log
3d/*.err.log
3d/third_party/ozz-master.zip
3d/third_party/ozz-animation-master/media/
3d/third_party/**/*.exe
3d/third_party/**/*.dll
3d/third_party/**/*.obj
3d/third_party/**/*.o

# 抖音视频素材与剪辑中间产物（125MB+，只留本地）
短视频/
tools/_cut_tiktok*.py
tools/_vid_*.py

# 本地放的 BGM（代码未引用，只用于剪视频）
assets/bgm/
